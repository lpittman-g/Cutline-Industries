# Thermal Postgres (core schema: streamers, heat_spikes, clips, retainers)
# Local:
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/thermal
# Production — copy the connection string from your provider (includes user + password).
# Prefer SSL: append ?sslmode=require (Neon/Supabase often include it; RDS should use SSL).
#   Neon Console:        https://console.neon.tech → Connection string
#   Supabase Dashboard:  Project Settings → Database → URI
#   AWS RDS Console:     Connectivity → endpoint → postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# SSL is auto-enabled for non-localhost hosts. Override with DATABASE_SSL=0|1
# DATABASE_SSL=1
# Optional full cert verify (default off for managed-provider compatibility):
# DATABASE_SSL_REJECT_UNAUTHORIZED=1

# Thermal Mission Control — heat → clip pipeline
THERMAL_HEAT_THRESHOLD=120
THERMAL_TWITCH_POLL_MS=30000
THERMAL_CLIP_SECONDS=22
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
DISCORD_HEAT_WEBHOOK_URL=

# AWS S3 clip storage (leave blank for local thermal_media/)
# Console: IAM https://console.aws.amazon.com/iam/home#/users
#          S3  https://s3.console.aws.amazon.com/s3/buckets
#          CF  https://console.aws.amazon.com/cloudfront/v4/home#/distributions
# Prefer an IAM role in production instead of permanent access keys.
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=thermal-video-clips
# Optional CDN base URL for watermarked previews + thumbnails (no trailing slash)
AWS_CLOUDFRONT_DOMAIN=
# Local/dev only — omit in production when the host has an IAM role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Stripe Checkout (gateway $15, bounty $50, retainer $750+/mo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional pre-created Stripe Price IDs (otherwise price_data is used)
STRIPE_PRICE_GATEWAY=
STRIPE_PRICE_BOUNTY=
STRIPE_PRICE_RETAINER=
# Override amounts in cents (defaults: 1500 gateway, 5000 bounty, 75000 retainer)
# STRIPE_GATEWAY_AMOUNT_CENTS=1500
# STRIPE_BOUNTY_AMOUNT_CENTS=5000
# STRIPE_RETAINER_AMOUNT_CENTS=75000
THERMAL_PUBLIC_URL=http://127.0.0.1:5173
# Auth: expose verification links in API responses (default on unless NODE_ENV=production)
# AUTH_DEV_EXPOSE_LINKS=1
# First matching signup becomes admin; local bypass only:
AUTH_BOOTSTRAP_ADMIN_EMAIL=lpittman@cutline-industries.studio
# AUTH_MC_OPEN=1
CUTLINE_APPROVAL_PAIR_SECRET=change-me-to-a-long-random-string
CUTLINE_NTFY_SERVER=https://ntfy.sh
# CUTLINE_NTFY_TOPIC=cutline-thermal-custom-name
CUTLINE_PUBLIC_URL=https://cutline-industries.studio

# Voice Print (local PC on same Wi‑Fi as HP OfficeJet — tools/voice-print)
VOICE_PRINT_PRINTER_IP=192.168.1.157
VOICE_PRINT_WAKE_WORD=print
VOICE_PRINT_PORT=8791
