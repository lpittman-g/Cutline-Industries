{
  "name": "cutline-industries",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "verify": "npm run lint && npm run typecheck && npm test",
    "preview": "vite preview",
    "api": "tsx server/api.ts",
    "autopilot": "tsx server/autopilot.ts",
    "autopilot:once": "tsx server/autopilot.ts --once",
    "ai:pipeline": "tsx server/aiAutopilot.ts",
    "ai:pipeline:once": "tsx server/aiAutopilot.ts --once",
    "auth:youtube": "tsx server/youtubeAuth.ts",
    "db:migrate": "tsx server/db/migrate.ts",
    "start": "concurrently -k \"npm:api\" \"npm:dev\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@types/pg": "^8.20.3",
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^173.0.0",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "7.18.2",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "sass": "^1.102.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
