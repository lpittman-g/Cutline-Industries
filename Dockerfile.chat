FROM python:3.12-slim
WORKDIR /app
COPY gateway/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY gateway/artemis/ artemis/
COPY gateway/configs/ configs/
COPY gateway/brains/ brains/
COPY site/ site/
ENV PORT=8080 ARTEMIS_BIND=0.0.0.0 ARTEMIS_COOKIE_SECURE=1
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/api/health', timeout=3)"
CMD ["python", "-m", "artemis.chat_app"]
