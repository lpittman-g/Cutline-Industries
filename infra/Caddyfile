git.cutline-industries.studio {
    reverse_proxy gitea:3000
    encode gzip
}

cutline-industries.studio, www.cutline-industries.studio {
    # HTTPS is automatic via Let's Encrypt — no config needed

    # API routes → Node.js
    handle /api/* {
        reverse_proxy api:8787
    }

    # Downloads — served directly from repo
    handle /downloads/* {
        root * /srv/repo/public
        file_server
        header Content-Disposition "attachment"
    }

    # Everything else → static frontend
    handle {
        reverse_proxy web:80
    }

    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}
