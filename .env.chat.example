# Server-only configuration. Do not copy this into a browser bundle.
VLLM_BASE_URL=http://YOUR_PRIVATE_INFERENCE_HOST:8000/v1
VLLM_MODEL=YOUR_SERVED_ARTEMIS_MODEL_NAME
VLLM_API_KEY=SET_AS_A_SERVER_SECRET
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_DATABASE/artemis?sslmode=require
ARTEMIS_CONTEXT_TOKENS=4096
ARTEMIS_CHAT_WORKERS=4
ARTEMIS_ALLOWED_ORIGINS=https://cutline-industries.vercel.app,https://cutline-industries.studio
ARTEMIS_COOKIE_SECURE=1
ARTEMIS_OWNER_EMAIL=YOUR_OWNER_ACCOUNT_EMAIL
ARTEMIS_BIND=127.0.0.1
PORT=8080
