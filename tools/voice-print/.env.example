# HP OfficeJet Pro 9120 — from Printer Status Report
VOICE_PRINT_PRINTER_IP=192.168.1.157
# Optional override (IPP URL)
# VOICE_PRINT_PRINTER_URI=http://192.168.1.157:631/ipp/print

VOICE_PRINT_PORT=8791
VOICE_PRINT_HOST=0.0.0.0
VOICE_PRINT_WAKE_WORD=print
VOICE_PRINT_DEFAULT_FILE=docs/combined-print.html

# HTML → PDF (Windows: Edge preferred, then Chrome)
# VOICE_PRINT_EDGE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# VOICE_PRINT_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Budget for headless conversion (default 60000). Raise if large blueprints hang.
# VOICE_PRINT_PDF_TIMEOUT_MS=60000
